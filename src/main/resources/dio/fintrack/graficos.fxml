<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="dio.fintrack.view.GraficosController"
      spacing="12" prefWidth="880" prefHeight="520">

    <padding>
        <Insets top="16" right="16" bottom="16" left="16"/>
    </padding>

    <Label text="Resumo financeiro" styleClass="titulo"/>

    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <PieChart fx:id="graficoCategorias" title="Despesas por categoria"
                      legendSide="BOTTOM" VBox.vgrow="ALWAYS"/>
            <Label fx:id="labelSemDespesas" text="Nenhuma despesa para exibir"
                   visible="false" managed="false"/>
        </VBox>

        <BarChart fx:id="graficoReceitaDespesa" title="Receitas x Despesas"
                  legendSide="BOTTOM" HBox.hgrow="ALWAYS">
            <xAxis>
                <CategoryAxis side="BOTTOM"/>
            </xAxis>
            <yAxis>
                <NumberAxis side="LEFT" label="R$"/>
            </yAxis>
        </BarChart>
    </HBox>

    <HBox alignment="CENTER_RIGHT">
        <Button text="Fechar" onAction="#fechar"/>
    </HBox>

</VBox>