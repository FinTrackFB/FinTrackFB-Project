
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>


<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="dio.fintrack.view.RelatorioController"
      alignment="CENTER"
      spacing="20"
      prefWidth="420"
      prefHeight="300">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <Label text="Relatório Financeiro"
           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <Label fx:id="labelReceitas"
           text="Total de Receitas: R$ 0,00"/>

    <Label fx:id="labelDespesas"
           text="Total de Despesas: R$ 0,00"/>

    <Label fx:id="labelSaldoFinal"
           text="Saldo Final: R$ 0,00"/>

    <Button text="Fechar"
            onAction="#fechar"/>

</VBox>
