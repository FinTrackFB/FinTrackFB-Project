<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="dio.fintrack.view.TelaPrincipalController">

    <top>
        <VBox spacing="12">
            <padding>
                <Insets top="16" right="16" bottom="8" left="16"/>
            </padding>
            <Label text="FinTrack" styleClass="titulo"/>
            <HBox spacing="12">
                <Label fx:id="labelReceitas" styleClass="card, card-receita"/>
                <Label fx:id="labelDespesas" styleClass="card, card-despesa"/>
                <Label fx:id="labelSaldo" styleClass="card, card-saldo"/>
            </HBox>
            <HBox spacing="8">
                <TextField fx:id="campoBusca" promptText="Buscar por id" prefWidth="140"/>
                <Button text="Buscar" onAction="#buscar"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tabela">
            <BorderPane.margin>
                <Insets left="16" right="16"/>
            </BorderPane.margin>
            <columns>
                <TableColumn fx:id="colunaId" text="Id" prefWidth="50"/>
                <TableColumn fx:id="colunaTipo" text="Tipo" prefWidth="90"/>
                <TableColumn fx:id="colunaData" text="Data" prefWidth="100"/>
                <TableColumn fx:id="colunaDescricao" text="Descrição" prefWidth="240"/>
                <TableColumn fx:id="colunaCategoria" text="Categoria" prefWidth="140"/>
                <TableColumn fx:id="colunaValor" text="Valor" prefWidth="130"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </center>

    <bottom>
        <HBox spacing="10">
            <padding>
                <Insets top="12" right="16" bottom="16" left="16"/>
            </padding>
            <Button text="Nova receita" onAction="#novaReceita"/>
            <Button text="Nova despesa" onAction="#novaDespesa"/>
            <Button text="Remover selecionada" onAction="#remover" styleClass="perigo"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Gráficos" onAction="#graficos"/>
            <Button text="Exportar CSV" onAction="#exportarCsv"/>
        </HBox>
    </bottom>

</BorderPane>